{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmos.example/schemas/inspector-evidence-1.2.schema.json",
  "title": "COSMOS INSPECTOR Evidence v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "source_id",
    "source_revision",
    "path",
    "algorithm",
    "digest",
    "captured_at"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "algorithm": {
      "const": "sha256"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
