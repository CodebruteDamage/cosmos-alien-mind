{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmos.invalid/contracts/inspector-request-v1.schema.json",
  "title": "COSMOS INSPECTOR Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "inspection_id",
    "target",
    "profile",
    "scope",
    "authorization_ref"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "inspection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "identifier"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "repository",
            "application",
            "engine",
            "workflow",
            "host",
            "integration",
            "configuration"
          ]
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "profile": {
      "type": "string",
      "enum": [
        "architecture",
        "code",
        "configuration",
        "integration",
        "defensive_security",
        "performance",
        "governance",
        "readiness",
        "comprehensive"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include",
        "mode"
      ],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mode": {
          "const": "READ_ONLY"
        }
      }
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1
    },
    "requirements_ref": {
      "type": "string"
    },
    "requested_by": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
