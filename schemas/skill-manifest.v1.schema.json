{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmos.local/schemas/skill-manifest.v1.json",
  "title": "COSMOS Skill Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_id", "name", "version", "description", "source",
    "license", "runtime", "capabilities", "risk_tier", "lifecycle"
  ],
  "properties": {
    "skill_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)([-+][0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "maxLength": 2000 },
    "owner": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision", "content_digest"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "minLength": 7 },
        "content_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx_id", "evidence_url", "review_status"],
      "properties": {
        "spdx_id": { "type": "string" },
        "evidence_url": { "type": "string", "format": "uri" },
        "review_status": { "enum": ["unverified", "approved", "restricted", "rejected"] }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapters", "dependencies"],
      "properties": {
        "adapters": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "scope", "approval_required"],
        "properties": {
          "capability": { "type": "string" },
          "scope": { "type": "array", "items": { "type": "string" } },
          "approval_required": { "type": "boolean" }
        }
      }
    },
    "risk_tier": { "enum": ["low", "moderate", "high", "critical"] },
    "lifecycle": {
      "enum": ["proposed", "inspecting", "quarantined", "validated", "approved", "enabled", "disabled", "deprecated"]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["not_started", "pending", "passed", "failed"] },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "reviewer": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "rollback": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "target_version": { "type": "string" },
        "procedure_ref": { "type": "string" }
      }
    }
  }
}
