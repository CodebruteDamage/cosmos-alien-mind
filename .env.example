# Set this in local .env.local and in your hosting provider's server-side environment settings.
# Use the Neon connection string with SSL enabled. Never prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Future server-side model integration. Do not commit real keys.
# AI_PROVIDER=
# AI_API_KEY=

# Server-to-server secret for COSMOS Live Data Swarm. Generate a random value
# of at least 32 characters and set it in local trusted node agents and Vercel.
# Never expose this token to browser/client code or commit its real value.
COSMOS_SWARM_TOKEN=
