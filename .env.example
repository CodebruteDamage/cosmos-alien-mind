# Set in local .env.local and hosting provider server-side environment settings.
# Never prefix secrets with NEXT_PUBLIC_ or commit real secret values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Webhook ingress remains disabled unless explicitly set to true.
COSMOS_WEBHOOK_ENABLED=false

# Configure one server-side secret per provisioned integration.
# The registry references the variable name; the secret value is never stored in the DB.
# Example only — use a generated value of at least 32 random bytes:
# COSMOS_WEBHOOK_SECRET_SUPPORT_APP=

# Future server-side model integration. Do not commit real keys.
# AI_PROVIDER=
# AI_API_KEY=
