# Server-only Neon PostgreSQL connection string for the isolated
# cosmos-neon-auth-preview branch. Never use a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Neon Auth server URL for the isolated preview branch.
NEON_AUTH_BASE_URL=https://ep-mute-butterfly-b3mcljt7.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth

# Generate locally with: openssl rand -base64 32
# Keep this value private. Never commit .env.local.
NEON_AUTH_COOKIE_SECRET=

