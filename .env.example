# Server-only Neon PostgreSQL connection string. Never use a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate a high-entropy secret of at least 32 characters.
# Example command: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Exact canonical application origin; use https in deployed environments.
BETTER_AUTH_URL=http://localhost:3000

# Future server-side model integration. Never commit real keys.
# AI_PROVIDER=
# AI_API_KEY=
