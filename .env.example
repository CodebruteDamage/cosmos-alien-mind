# Server-side GitHub fine-grained token. Grant read-only repository metadata and Actions read access only.
GITHUB_TOKEN=

# Comma-separated exact owner/repository allowlist, maximum 20.
COSMOS_INSPECTOR_REPOSITORIES=CodebruteDamage/cosmos-alien-mind,CodebruteDamage/cosmos-cyber-sec-ops

# Random server-side access token for the Inspector dashboard/API (minimum 24 characters).
COSMOS_INSPECTOR_ACCESS_TOKEN=
