# Server-only Neon PostgreSQL connection string. Never use a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate a high-entropy secret of at least 32 characters.
BETTER_AUTH_SECRET=

# Exact canonical application origin; use HTTPS outside local development.
BETTER_AUTH_URL=http://localhost:3000

# WARP GATE is a separate authorization authority.
# No provider is wired in this branch yet; protected conversation APIs deny by default.
