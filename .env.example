# Set this in local .env.local and in your hosting provider's server-side environment settings.
# Use the Neon connection string with SSL enabled. Never prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Webhook ingress remains disabled unless explicitly set to true.
# Generate at least 32 random bytes and store only in server-side secret settings.
# Never commit a real webhook secret.
COSMOS_WEBHOOK_ENABLED=false
COSMOS_WEBHOOK_SECRET=

# Future server-side model integration. Do not commit real keys.
# AI_PROVIDER=
# AI_API_KEY=
