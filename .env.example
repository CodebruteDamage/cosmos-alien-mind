# Neon database connection (server-side only).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# GPT provider (server-side only; never use NEXT_PUBLIC_).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Existing Android bridge bearer secret (server-side only; minimum 32 characters).
BRIDGE_SHARED_SECRET=

# Trusted node telemetry ingestion / analytics bearer token (server-side only; minimum 32 characters).
COSMOS_SWARM_TOKEN=
